# IMPORTANT: These files are licensed and must NOT be committed.
# ============================================================

body_models/
data/body_models/
models/body_models/

SMPL/
SMPLX/
SMPL-X/
MANO/
FLAME/

smpl/
smplx/
mano/
flame/

*.pkl
*.npz

# Exception: allow small config npz/pkl only if explicitly force-added.
# In this project, safest default is to ignore all .pkl and .npz files.


