# ============================================================

*.o
*.obj
*.cu.o
*.cubin
*.ptx

build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
Makefile

torch_extensions/
~/.cache/torch_extensions/


# ============================================================
# 13. External repositories cloned inside the project
# Useful if you clone PromptHMR, FastHMR, SHAPY, VIBE as subfolders
# but do NOT want to commit their full source.
# ============================================================

external/
third_party/
submodules_local/

PromptHMR/
FastHMR/
SHAPY/
VIBE/
SMPL-Anthropometry/

# If you want to keep your own wrapper code inside these folders,
# remove the corresponding ignore rule above and instead ignore only:
# PromptHMR/data/
# PromptHMR/outputs/
# PromptHMR/checkpoints/
# FastHMR/data/
# FastHMR/outputs/
# SHAPY/data/
# SHAPY/outputs/
# VIBE/data/
# VIBE/outputs/


# ============================================================
# 14. Reports: keep source files, ignore generated heavy exports
# ============================================================

*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

# Optional: ignore generated PDFs if you only want LaTeX source in Git
# *.pdf


# ============================================================
# 15. Keep important lightweight project files
# ============================================================

!.gitignore
!README.md
!requirements.txt
!environment.yml
!environment_prompt_hmr.yml
!environment_fasthmr.yml
!environment_shapy.yml
!environment_vibe.yml
!scripts/
!src/
!notebooks/
!docs/
!reports/
!configs/
!configs/**/*.yaml
!configs/**/*.yml
!configs/**/*.json

# Keep placeholder files so empty folders can exist in Git
!.gitkeep
!**/.gitkeep