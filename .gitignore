# ============================================================
# GLOBAL .gitignore for SMPL-Based Model Deployment Project
# PromptHMR / FastHMR / SHAPY / VIBE / SMPL / SMPL-X
# ============================================================


# ============================================================
# 1. Python cache and build files
# ============================================================

__pycache__/
*.py[cod]
*$py.class

*.so
*.pyd
*.dll
*.dylib

build/
dist/
.eggs/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/


# ============================================================
# 2. Virtual environments / Conda environments
# ============================================================

.venv/
venv/
env/
ENV/
envs/
conda-env/
.conda/
.ipynb_checkpoints/

# Do not commit local environment exports unless intentionally cleaned
environment.local.yml
environment_local.yml
conda_env_export.yml
pip_freeze.txt


# ============================================================
# 3. Jupyter / VSCode
# ============================================================

.ipynb_checkpoints/
*.nbconvert.ipynb

# Optional: ignore notebooks with heavy outputs if you create copies
*_executed.ipynb
*_outputs.ipynb
*_debug.ipynb

.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.idea/


# ============================================================
# 4. OS files
# ============================================================

.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini


# ============================================================
# 5. Logs and temporary files
# ============================================================

*.log
logs/
log/
tmp/
temp/
.cache/
cache/
*.tmp
*.bak
*.swp
*.swo

nohup.out
wandb/
mlruns/
tensorboard/
runs/


# ============================================================
