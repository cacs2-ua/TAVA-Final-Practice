# ============================================================

.env
.env.*
*.env

secrets/
credentials/
tokens/
api_keys/
*.key
*.pem
*.crt
*.p12
*.json.key

# Hugging Face / Weights & Biases / dataset credentials
.huggingface/
.netrc


