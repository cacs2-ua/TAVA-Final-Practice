# Dockerfile.shapy
# Reproducible SHAPY environment based on the official tested stack:
# Python 3.8 + CUDA 10.2 + PyTorch 1.7.1.

FROM kitware/nvidia-cuda:10.2-devel-ubuntu18.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Madrid
ENV PYTHONUNBUFFERED=1
ENV PYOPENGL_PLATFORM=egl
ENV FORCE_CUDA=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    build-essential \
    git \
    wget \
    curl \
    unzip \
    ca-certificates \
    ninja-build \
    cmake \
    pkg-config \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libosmesa6-dev \
    libegl1-mesa-dev \
    libgles2-mesa-dev \
    libglfw3-dev \
    libglew-dev \
    libxrender1 \
    libxext6 \
    libsm6 \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

RUN add-apt-repository ppa:deadsnakes/ppa -y && \
    apt-get update && apt-get install -y --no-install-recommends \
    python3.8 \
    python3.8-dev \
    python3.8-venv \
    python3.8-distutils \
    && rm -rf /var/lib/apt/lists/*

RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.8

WORKDIR /workspace

RUN git clone https://github.com/muelea/shapy.git

WORKDIR /workspace/shapy

RUN python3.8 -m venv .venv/shapy

SHELL ["/bin/bash", "-c"]

RUN source .venv/shapy/bin/activate && \
    python -m pip install --upgrade pip==23.3.2 setuptools==59.5.0 wheel==0.37.1 && \
    python -m pip install ipykernel notebook jupyterlab

# Install PyTorch first, explicitly, to avoid accidentally installing a CPU-only wheel.
RUN source .venv/shapy/bin/activate && \
    python -m pip install \
    torch==1.7.1+cu102 \
    torchvision==0.8.2+cu102 \
    -f https://download.pytorch.org/whl/torch_stable.html

# Fixed SHAPY requirements, excluding torch/torchvision because they were installed above.
RUN cat > requirements_shapy_fixed.txt <<'EOF'
chumpy==0.70
imageio==2.9.0
jpeg4py==0.1.4
joblib==1.0.0
kornia==0.4.1
loguru==0.5.3
matplotlib==3.3.3
numpy==1.19.5
omegaconf==2.0.6
opencv-python==4.5.1.48
open3d==0.13.0
Pillow==8.4.0
PyOpenGL==3.1.0
pyrender==0.1.43
pytorch-lightning==1.3.0rc1
scikit-image==0.18.1
scikit-learn==0.24.0
scipy==1.6.0
sklearn==0.0
smplx==0.1.27
torchgeometry==0.1.2
torchmetrics==0.2.0
tqdm==4.55.1
trimesh==3.9.1
yacs==0.1.8
fvcore
nflows==0.14
PyYAML==5.3.1
protobuf==3.20.3
EOF

RUN source .venv/shapy/bin/activate && \
    export SKLEARN_ALLOW_DEPRECATED_SKLEARN_PACKAGE_INSTALL=True && \
    python -m pip install Cython==0.29.36 && \
    python -m pip install --no-cache-dir -r requirements_shapy_fixed.txt

# Install local SHAPY components.
RUN source .venv/shapy/bin/activate && \
    export PYTHONPATH=$PYTHONPATH:/workspace/shapy/attributes && \
    cd /workspace/shapy/attributes && \
    python setup.py install

RUN source .venv/shapy/bin/activate && \
    cd /workspace/shapy/mesh-mesh-intersection && \
    export CUDA_SAMPLES_INC=$(pwd)/include && \
    python -m pip install -r requirements.txt && \
    python setup.py install

RUN source .venv/shapy/bin/activate && \
    python -m ipykernel install --name shapy-py38 --display-name "SHAPY Python 3.8" --sys-prefix

ENV SHAPY_ROOT=/workspace/shapy
ENV PYTHONPATH=/workspace/shapy:/workspace/shapy/attributes:$PYTHONPATH

WORKDIR /workspace/shapy

CMD ["/bin/bash"]